{
  "info": {
    "name": "ERP - Quotation Module",
    "description": "Enterprise Quotation Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('auth_token', jsonData.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "Quotations",
      "item": [
        {
          "name": "Create Quotation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"quotation_date\": \"2026-06-27\",\n  \"valid_until\": \"2026-07-12\",\n  \"notes\": \"Please review and confirm\",\n  \"items\": [\n    {\n      \"description\": \"Office Desk Wooden\",\n      \"quantity\": 5,\n      \"unit\": \"pcs\",\n      \"unit_price\": 8500,\n      \"discount_percentage\": 10,\n      \"tax_percentage\": 18,\n      \"remarks\": \"Standard size\"\n    },\n    {\n      \"description\": \"Office Chair Ergonomic\",\n      \"quantity\": 10,\n      \"unit\": \"pcs\",\n      \"unit_price\": 12500,\n      \"discount_percentage\": 5,\n      \"tax_percentage\": 18,\n      \"remarks\": null\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/quotations",
              "host": ["{{base_url}}"],
              "path": ["quotations"]
            }
          }
        },
        {
          "name": "List Quotations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/quotations?per_page=15",
              "host": ["{{base_url}}"],
              "path": ["quotations"],
              "query": [
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "", "disabled": true },
                { "key": "customer_id", "value": "", "disabled": true },
                { "key": "date_from", "value": "", "disabled": true },
                { "key": "date_to", "value": "", "disabled": true },
                { "key": "sort", "value": "created_at", "disabled": true },
                { "key": "direction", "value": "desc", "disabled": true },
                { "key": "per_page", "value": "15" }
              ]
            }
          }
        },
        {
          "name": "Get Quotation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/quotations/1",
              "host": ["{{base_url}}"],
              "path": ["quotations", "1"]
            }
          }
        },
        {
          "name": "Update Quotation",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valid_until\": \"2026-08-01\",\n  \"status\": \"sent\",\n  \"notes\": \"Extended validity requested\",\n  \"items\": [\n    {\n      \"description\": \"Office Desk Wooden\",\n      \"quantity\": 5,\n      \"unit\": \"pcs\",\n      \"unit_price\": 8500,\n      \"discount_percentage\": 10,\n      \"tax_percentage\": 18\n    },\n    {\n      \"description\": \"Office Chair Ergonomic - Premium\",\n      \"quantity\": 8,\n      \"unit\": \"pcs\",\n      \"unit_price\": 15000,\n      \"discount_percentage\": 5,\n      \"tax_percentage\": 18\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/quotations/1",
              "host": ["{{base_url}}"],
              "path": ["quotations", "1"]
            }
          }
        },
        {
          "name": "Delete Quotation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/quotations/1",
              "host": ["{{base_url}}"],
              "path": ["quotations", "1"]
            }
          }
        },
        {
          "name": "Restore Quotation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/quotations/1/restore",
              "host": ["{{base_url}}"],
              "path": ["quotations", "1", "restore"]
            }
          }
        },
        {
          "name": "Download Quotation PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/quotations/1/download-pdf",
              "host": ["{{base_url}}"],
              "path": ["quotations", "1", "download-pdf"]
            }
          }
        }
      ]
    }
  ]
}
